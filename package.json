{
  "name": "video-grabber",
  "version": "1.1.6",
  "description": "Công cụ tải video/audio miễn phí từ YouTube, Facebook, TikTok và 1000+ nền tảng khác. Hỗ trợ chất lượng 720p/1080p/2K/4K, xuất MP4/MP3.",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "postinstall": "node scripts/setup-ytdlp.js"
  },
  "keywords": [
    "youtube-downloader",
    "tiktok-downloader",
    "facebook-downloader",
    "video-downloader",
    "yt-dlp",
    "mp3-converter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.videograbber.app",
    "productName": "Video Grabber",
    "asar": false,
    "files": [
      "electron/**/*",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "bin/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "VideoGrabberSetup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VideoGrabberPortable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sinhgiang",
        "repo": "video-grabber"
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
}
