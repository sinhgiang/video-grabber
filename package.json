{
  "name": "video-grabber",
  "version": "1.0.0",
  "description": "Công cụ tải video/audio miễn phí từ YouTube, Facebook, TikTok và 1000+ nền tảng khác. Hỗ trợ chất lượng 720p/1080p/2K/4K, xuất MP4/MP3.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "postinstall": "node scripts/setup-ytdlp.js"
  },
  "keywords": [
    "youtube-downloader",
    "tiktok-downloader",
    "facebook-downloader",
    "video-downloader",
    "yt-dlp",
    "mp3-converter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "engines": {
    "node": ">=18"
  }
}
